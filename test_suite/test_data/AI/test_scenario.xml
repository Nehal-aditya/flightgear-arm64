<!--
  Minimal AI scenario fixture for AIManagerTests::testReinitPreservesScenario.
  A single stationary ship is enough to check that the scenario survives a
  subsystem reinit and is reloaded by postinit(). See issue #3388.
-->
<PropertyList>
  <scenario>
    <name>AIManager reinit test scenario</name>
    <description>Single ship, used to verify scenarios survive a subsystem reinit.</description>
    <entry>
      <type>ship</type>
      <name>test-ship</name>
      <latitude>63.985</latitude>
      <longitude>-22.605</longitude>
      <heading>0</heading>
      <speed>0</speed>
    </entry>
  </scenario>
</PropertyList>
